# Auth0, from your tenant's application settings
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# A long random value the session cookie is signed with: openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
# The API identifier of the workspace API in Auth0
AUTH0_AUDIENCE=https://api.workspace.example/
